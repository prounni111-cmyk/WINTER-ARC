<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Winter Arc Tracker - വിന്റർ ആർക്ക് ട്രാക്കർ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Noto+Sans+Malayalam:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Manrope', 'Noto Sans Malayalam', 'sans-serif'],
                    },
                    colors: {
                        winter: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0ea5e9',
                            800: '#075985',
                            900: '#0c4a6e',
                            950: '#082f49',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            body {
                background: white !important;
                color: black !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .print-container {
                box-shadow: none !important;
                border: none !important;
                width: 100% !important;
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            table {
                font-size: 10px !important;
                border-color: #000 !important;
            }
            th, td {
                border-color: #000 !important;
                padding: 2px 4px !important;
            }
            .print-border {
                border: 1px solid #000 !important;
            }
        }

        /* Custom scrollbar for mobile grid viewing */
        .grid-scroll::-webkit-scrollbar {
            height: 6px;
        }
        .grid-scroll::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .grid-scroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen pb-12">

    <!-- Control Header (No Print) -->
    <header class="no-print bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50 py-3 px-4 mb-6">
        <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-2">
                <span class="text-2xl">❄️</span>
                <h1 class="font-bold text-lg text-sky-400">Winter Arc Tracker</h1>
                <span class="text-xs bg-sky-900 text-sky-200 px-2 py-0.5 rounded-full border border-sky-700">Malayalam + English</span>
            </div>
            
            <div class="flex items-center gap-2">
                <button onclick="window.print()" class="bg-sky-500 hover:bg-sky-600 text-slate-950 font-bold px-4 py-2 rounded-lg text-sm flex items-center gap-1.5 transition shadow-lg shadow-sky-500/20">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Print / Save PDF
                </button>
                <button onclick="resetData()" class="bg-slate-700 hover:bg-rose-900/60 hover:text-rose-300 text-slate-300 font-medium px-3 py-2 rounded-lg text-sm transition">
                    Reset All
                </button>
            </div>
        </div>
    </header>

    <!-- Main Printable Sheet Container -->
    <div class="max-w-6xl mx-auto px-2 sm:px-4">
        <div class="print-container bg-slate-950 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-2xl text-slate-200">
            
            <!-- Document Header -->
            <div class="border-b border-slate-700 pb-4 mb-5">
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xl sm:text-2xl">❄️</span>
                    <h2 class="text-xl sm:text-3xl font-extrabold tracking-wider text-center uppercase text-white font-serif">
                        <span class="hidden sm:inline">❖ </span>THE WINTER ARC<span class="hidden sm:inline"> ❖</span>
                    </h2>
                    <span class="text-xl sm:text-2xl">❄️</span>
                </div>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm mt-4">
                    <div class="flex items-center gap-2">
                        <label class="font-bold text-sky-400 min-w-fit">പേര് / Name:</label>
                        <input type="text" id="userName" placeholder="Your Name" class="bg-slate-900 border border-slate-700 rounded px-3 py-1 w-full text-white focus:outline-none focus:border-sky-500 transition print:border-b print:border-black print:bg-transparent">
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="font-bold text-sky-400 min-w-fit">മാസം / Month:</label>
                        <input type="text" id="userMonth" placeholder="October / November" class="bg-slate-900 border border-slate-700 rounded px-3 py-1 w-full text-white focus:outline-none focus:border-sky-500 transition print:border-b print:border-black print:bg-transparent">
                    </div>
                </div>
            </div>

            <!-- SECTION 1: HABIT / SKILLS TRACKER -->
            <div class="mb-6">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="font-bold text-base sm:text-lg text-sky-300 flex items-center gap-2">
                        📌 Habit / Skill Tracker (ശീലങ്ങൾ)
                    </h3>
                    <span class="text-xs text-slate-400 no-print">ക്ലിക്ക് ചെയ്ത് പൂർത്തിയാക്കിയത് അടയാളപ്പെടുത്താം</span>
                </div>

                <div class="overflow-x-auto grid-scroll border border-slate-700 rounded-lg">
                    <table class="w-full text-xs text-center border-collapse">
                        <thead>
                            <tr class="bg-slate-800 text-sky-300 font-semibold border-b border-slate-700">
                                <th class="p-2 text-left min-w-[160px] border-r border-slate-700">Habit / Skill (ശീലം)</th>
                                <!-- Days 1 to 31 -->
                                <script>
                                    for(let i=1; i<=31; i++) {
                                        document.write(`<th class="p-1 min-w-[24px] sm:min-w-[28px] border-r border-slate-700/60">${i}</th>`);
                                    }
                                </script>
                            </tr>
                        </thead>
                        <tbody id="habitRows">
                            <!-- JS populated rows -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 2: SLEEP / MOBILE SCREEN TIME -->
            <div class="mb-6">
                <div class="flex justify-between items-center mb-2">
                    <h3 class="font-bold text-base sm:text-lg text-sky-300 flex items-center gap-2">
                        🌙 Sleep / Mobile Screen Time (ഉറക്കം / മൊബൈൽ സമയം)
                    </h3>
                </div>

                <div class="overflow-x-auto grid-scroll border border-slate-700 rounded-lg">
                    <table class="w-full text-xs text-center border-collapse">
                        <thead>
                            <tr class="bg-slate-800 text-sky-300 font-semibold border-b border-slate-700">
                                <th class="p-2 text-left min-w-[160px] border-r border-slate-700">Hours (മണിക്കൂറുകൾ)</th>
                                <script>
                                    for(let i=1; i<=31; i++) {
                                        document.write(`<th class="p-1 min-w-[24px] sm:min-w-[28px] border-r border-slate-700/60">${i}</th>`);
                                    }
                                </script>
                            </tr>
                        </thead>
                        <tbody id="sleepRows">
                            <!-- JS populated rows for 10 hrs down to 4 hrs -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 3: MONTHLY GOALS & REFLECTIONS -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Box 1 -->
                <div class="border border-slate-700 rounded-lg p-3 bg-slate-900/50 print-border">
                    <h4 class="font-bold text-sm text-sky-400 mb-2 border-b border-slate-700 pb-1 uppercase tracking-wide">
                        🎯 MY MONTHLY GOAL <br><span class="text-xs text-slate-400 font-normal lowercase">(ഈ മാസത്തെ ലക്ഷ്യം)</span>
                    </h4>
                    <textarea id="monthlyGoal" rows="4" placeholder="1. 5 KGs weight loss&#10;2. Complete 2 books&#10;3. Wake up at 5:30 AM" class="w-full bg-transparent text-xs text-slate-200 focus:outline-none resize-none print:text-black"></textarea>
                </div>

                <!-- Box 2 -->
                <div class="border border-slate-700 rounded-lg p-3 bg-slate-900/50 print-border">
                    <h4 class="font-bold text-sm text-emerald-400 mb-2 border-b border-slate-700 pb-1 uppercase tracking-wide">
                        🏆 WHAT I HAVE ACHIEVED <br><span class="text-xs text-slate-400 font-normal lowercase">(ഞാൻ കൈവരിച്ച നേട്ടങ്ങൾ)</span>
                    </h4>
                    <textarea id="achievements" rows="4" placeholder="1. 20 Days workout completed&#10;2. Reduced screen time..." class="w-full bg-transparent text-xs text-slate-200 focus:outline-none resize-none print:text-black"></textarea>
                </div>

                <!-- Box 3 -->
                <div class="border border-slate-700 rounded-lg p-3 bg-slate-900/50 print-border">
                    <h4 class="font-bold text-sm text-amber-400 mb-2 border-b border-slate-700 pb-1 uppercase tracking-wide">
                        💡 WHAT SHOULD I IMPROVE <br><span class="text-xs text-slate-400 font-normal lowercase">(മെച്ചപ്പെടുത്തേണ്ടവ)</span>
                    </h4>
                    <textarea id="improvements" rows="4" placeholder="1. Avoid night mobile usage&#10;2. Drink more water..." class="w-full bg-transparent text-xs text-slate-200 focus:outline-none resize-none print:text-black"></textarea>
                </div>
            </div>

            <!-- Footer Note -->
            <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center text-xs text-slate-500">
                <span>Winter Arc Self-Discipline Routine</span>
                <span>Stay Consistent. Win Winter. ❄️</span>
            </div>

        </div>
    </div>

    <script>
        // Default habits list
        const defaultHabits = [
            "1. Workout / എക്സർസൈസ്",
            "2. 2 Hr Home Study / പഠനം",
            "3. No Junk Food / നല്ല ഭക്ഷണം",
            "4. Book Reading / പുസ്തകം വായന",
            "5. Early Morning Wakeup",
            "6. Water Intake (3 Litres)",
            "7. Meditation / ധ്യാനം",
            "8. No Social Media Binge",
            "9. Gratitude Journaling",
            "10. Cold Shower / വാക്ക്"
        ];

        const sleepHours = [
            "10 hrs", "9 hrs", "8 hrs", "7 hrs", "6 hrs", "5 hrs", "4 hrs"
        ];

        // State Object
        let trackerData = {
            name: '',
            month: '',
            habits: {}, // habitIndex-day -> true/false
            habitNames: [...defaultHabits],
            sleep: {}, // hourIndex-day -> true/false
            goal: '',
            achieved: '',
            improve: ''
        };

        // Load data from localStorage
        function loadTrackerData() {
            const saved = localStorage.getItem('winter_arc_tracker_data');
            if (saved) {
                try {
                    trackerData = Object.assign(trackerData, JSON.parse(saved));
                } catch(e) {
                    console.error("Error loading saved data", e);
                }
            }
            renderUI();
        }

        // Save data to localStorage
        function saveData() {
            trackerData.name = document.getElementById('userName').value;
            trackerData.month = document.getElementById('userMonth').value;
            trackerData.goal = document.getElementById('monthlyGoal').value;
            trackerData.achieved = document.getElementById('achievements').value;
            trackerData.improve = document.getElementById('improvements').value;

            localStorage.setItem('winter_arc_tracker_data', JSON.stringify(trackerData));
        }

        // Render entire tracker UI
        function renderUI() {
            // Header inputs
            document.getElementById('userName').value = trackerData.name || '';
            document.getElementById('userMonth').value = trackerData.month || '';
            document.getElementById('monthlyGoal').value = trackerData.goal || '';
            document.getElementById('achievements').value = trackerData.achieved || '';
            document.getElementById('improvements').value = trackerData.improve || '';

            // Render Habit Rows
            const habitContainer = document.getElementById('habitRows');
            habitContainer.innerHTML = '';

            trackerData.habitNames.forEach((habitName, hIdx) => {
                const tr = document.createElement('tr');
                tr.className = "border-b border-slate-800 hover:bg-slate-900/50 transition";

                // Habit Name editable cell
                let html = `
                    <td class="p-1.5 text-left border-r border-slate-700/80 font-medium">
                        <input type="text" value="${escapeHtml(habitName)}" 
                            onchange="updateHabitName(${hIdx}, this.value)"
                            class="bg-transparent text-slate-200 w-full focus:outline-none focus:text-sky-300 text-xs">
                    </td>
                `;

                // Days 1-31 Checkboxes / Boxes
                for (let day = 1; day <= 31; day++) {
                    const key = `${hIdx}-${day}`;
                    const isChecked = !!trackerData.habits[key];
                    html += `
                        <td class="p-1 border-r border-slate-800 text-center cursor-pointer select-none ${isChecked ? 'bg-sky-500/30 text-sky-300 font-bold' : 'hover:bg-slate-800'}"
                            onclick="toggleHabit('${key}')">
                            ${isChecked ? '✓' : ''}
                        </td>
                    `;
                }

                tr.innerHTML = html;
                habitContainer.appendChild(tr);
            });

            // Render Sleep / Mobile Rows
            const sleepContainer = document.getElementById('sleepRows');
            sleepContainer.innerHTML = '';

            sleepHours.forEach((hourLabel, sIdx) => {
                const tr = document.createElement('tr');
                tr.className = "border-b border-slate-800 hover:bg-slate-900/50 transition";

                let html = `
                    <td class="p-1.5 text-left border-r border-slate-700/80 font-semibold text-slate-300">
                        ${hourLabel}
                    </td>
                `;

                for (let day = 1; day <= 31; day++) {
                    const key = `${sIdx}-${day}`;
                    const isChecked = !!trackerData.sleep[key];
                    html += `
                        <td class="p-1 border-r border-slate-800 text-center cursor-pointer select-none ${isChecked ? 'bg-indigo-500/40 text-indigo-300 font-bold' : 'hover:bg-slate-800'}"
                            onclick="toggleSleep('${key}')">
                            ${isChecked ? '●' : ''}
                        </td>
                    `;
                }

                tr.innerHTML = html;
                sleepContainer.appendChild(tr);
            });
        }

        // Toggle habit box
        function toggleHabit(key) {
            trackerData.habits[key] = !trackerData.habits[key];
            saveData();
            renderUI();
        }

        // Toggle sleep box
        function toggleSleep(key) {
            trackerData.sleep[key] = !trackerData.sleep[key];
            saveData();
            renderUI();
        }

        // Update custom habit title
        function updateHabitName(index, newName) {
            trackerData.habitNames[index] = newName;
            saveData();
        }

        // Escape string for input value safety
        function escapeHtml(str) {
            return str.replace(/"/g, '&quot;');
        }

        // Reset Data
        function resetData() {
            if (window.confirm("നിങ്ങൾക്ക് എല്ലാ ട്രാക്കിംഗ് ഡാറ്റയും മാറ്റണോ? (Are you sure you want to reset all data?)")) {
                localStorage.removeItem('winter_arc_tracker_data');
                trackerData = {
                    name: '',
                    month: '',
                    habits: {},
                    habitNames: [...defaultHabits],
                    sleep: {},
                    goal: '',
                    achieved: '',
                    improve: ''
                };
                renderUI();
            }
        }

        // Listeners for text inputs
        document.getElementById('userName').addEventListener('input', saveData);
        document.getElementById('userMonth').addEventListener('input', saveData);
        document.getElementById('monthlyGoal').addEventListener('input', saveData);
        document.getElementById('achievements').addEventListener('input', saveData);
        document.getElementById('improvements').addEventListener('input', saveData);

        // Initialize on page load
        window.onload = function() {
            loadTrackerData();
        };
    </script>
</body>
</html>

